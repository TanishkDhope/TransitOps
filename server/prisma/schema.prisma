generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------
enum Role {
  ADMIN
  FLEET_MANAGER
  DRIVER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
  ARCHIVED // soft-delete: preserved for trip history, never assignable
}

enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  OPEN // active -> vehicle IN_SHOP
  CLOSED // -> vehicle back to AVAILABLE
}

enum ExpenseType {
  TOLL
  PARKING
  FINE
  MAINTENANCE
  OTHER
}

enum NotificationType {
  LICENSE_EXPIRY
  INSURANCE_EXPIRY
  PUC_EXPIRY
  SERVICE_DUE
}

// ---------- MODELS ----------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  username     String   @unique
  role         Role     @default(DRIVER)
  refreshToken String?
  driver       Driver? // optional link if this user IS a driver
  auditLogs    AuditLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id              String        @id @default(cuid())
  registrationNo  String        @unique // business rule: unique
  name            String // model / name
  type            String // Van, Truck, Bike...
  maxLoadKg       Float
  odometer        Float         @default(0)
  acquisitionCost Decimal       @db.Decimal(12, 2)
  region          String? // for dashboard filters
  status          VehicleStatus @default(AVAILABLE)

  rcNumber         String?
  insuranceNumber  String?
  insuranceExpiry  DateTime?
  pucNumber        String?
  pucExpiry        DateTime?
  insuranceExpired Boolean   @default(false) // auto-maintained by the insurance expiry cron
  pucExpired       Boolean   @default(false) // auto-maintained by the PUC expiry cron
  documentUrls     String[]  @default([]) // Cloudinary URLs of uploaded RC/Insurance/PUC images

  // preventive maintenance scheduling
  serviceIntervalKm   Float? // e.g. service every 10000 km
  lastServiceOdometer Float  @default(0)

  trips           Trip[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  expenses        Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Driver {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  name            String
  email           String       @unique
  licenseNumber   String       @unique
  licenseCategory String // LMV, HMV, etc.
  licenseExpiry   DateTime
  contactNumber   String
  safetyScore     Int          @default(100) // derived — see services/safety.service.js
  status          DriverStatus @default(AVAILABLE)
  licenseFrontUrl String?
  licenseBackUrl  String?
  suspensionReason String?

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  // rate card: revenue = flatRate ?? (ratePerKm * distance) + (ratePerTonneKm * distance * tonnes)
  ratePerKm      Decimal? @db.Decimal(10, 2)
  ratePerTonneKm Decimal? @db.Decimal(10, 2)
  flatRate       Decimal? @db.Decimal(12, 2)

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model Trip {
  id              String     @id @default(cuid())
  source          String
  destination     String
  cargoWeightKg   Float
  plannedDistance Float
  status          TripStatus @default(DRAFT)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  driverId  String
  driver    Driver  @relation(fields: [driverId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // scheduling window — availability is an interval-overlap question
  plannedStart DateTime
  plannedEnd   DateTime

  // filled on completion
  startOdometer Float?
  endOdometer   Float?
  fuelConsumedL Float?
  revenue       Decimal? @db.Decimal(12, 2) // needed for ROI

  dispatchedAt DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  fuelLogs FuelLog[]
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([vehicleId, plannedStart, plannedEnd])
  @@index([driverId, plannedStart, plannedEnd])
}

model MaintenanceLog {
  id          String            @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  description String // "Oil Change"
  cost        Decimal           @default(0) @db.Decimal(12, 2)
  status      MaintenanceStatus @default(OPEN)
  startedAt   DateTime          @default(now())
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, status])
}

model FuelLog {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  tripId    String?
  trip      Trip?   @relation(fields: [tripId], references: [id])

  liters   Float
  cost     Decimal  @db.Decimal(12, 2)
  loggedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([tripId])
}

model Expense {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  tripId    String?
  trip      Trip?   @relation(fields: [tripId], references: [id])

  type       ExpenseType
  amount     Decimal     @db.Decimal(12, 2)
  note       String?
  incurredAt DateTime    @default(now())

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([tripId])
}

// Who changed what, when. Written inside the same transaction as the mutation.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String? // denormalised so the trail survives user deletion
  entity     String // "Vehicle" | "Driver" | "Trip" | ...
  entityId   String
  action     String // "CREATE" | "UPDATE" | "DELETE" | "DISPATCH" | ...
  summary    String? // human-readable one-liner
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
}

// Delivery record + cooldown latch so recipients are not spammed every cron tick.
model NotificationLog {
  id        String           @id @default(cuid())
  type      NotificationType
  subjectId String // driverId or vehicleId the notice is about
  recipient String // email address
  success   Boolean          @default(true)
  error     String?
  sentAt    DateTime         @default(now())

  @@index([type, subjectId, sentAt])
  @@index([recipient])
}
